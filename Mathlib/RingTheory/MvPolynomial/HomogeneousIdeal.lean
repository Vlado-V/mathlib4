module

public import Mathlib.RingTheory.MvPolynomial.Homogeneous

/-!
# Ideals generated in one homogeneous degree

If a submodule `W` consists of polynomials of degree `d`, the degree-`d + e` component of
the ideal generated by `W` is the product of `W` and the degree-`e` homogeneous submodule.
In particular, that ideal has no nonzero homogeneous polynomials of degree less than `d`.
-/

@[expose] public section

namespace MvPolynomial

variable {σ R : Type*} [CommSemiring R] {d : ℕ}

/-- Multiplication by a homogeneous polynomial shifts homogeneous components. -/
theorem homogeneousComponent_mul_of_isHomogeneous (e : ℕ) (f p : MvPolynomial σ R)
    (hf : f.IsHomogeneous d) :
    homogeneousComponent (d + e) (f * p) = f * homogeneousComponent e p := by
  induction p using MvPolynomial.induction_on' with
  | monomial a c =>
      have ha : (monomial a c : MvPolynomial σ R).IsHomogeneous a.degree :=
        isHomogeneous_monomial c rfl
      rw [homogeneousComponent_of_mem (hf.mul ha), homogeneousComponent_of_mem ha]
      by_cases h : a.degree = e
      · simp [h]
      · simp [Ne.symm h]
  | add p q hp hq => simp only [mul_add, map_add, hp, hq]

/-- Homogeneous components of an element of an ideal generated in degree `d` are obtained
using homogeneous multipliers of the complementary degree. -/
theorem homogeneousComponent_mem_mul_of_mem_ideal_span (e : ℕ)
    (W : Submodule R (MvPolynomial σ R)) (hW : W ≤ homogeneousSubmodule σ R d)
    {p : MvPolynomial σ R} (hp : p ∈ Ideal.span (W : Set (MvPolynomial σ R))) :
    homogeneousComponent (d + e) p ∈ W * homogeneousSubmodule σ R e := by
  have hall : ∀ a : MvPolynomial σ R,
      homogeneousComponent (d + e) (a * p) ∈ W * homogeneousSubmodule σ R e := by
    induction hp using Submodule.span_induction with
    | mem f hf =>
        intro a
        rw [mul_comm a f, homogeneousComponent_mul_of_isHomogeneous e f a (hW hf)]
        exact Submodule.mul_mem_mul hf (homogeneousComponent_mem e a)
    | zero => intro a; simp
    | add p q hp hq ihp ihq =>
        intro a
        rw [mul_add, map_add]
        exact (W * homogeneousSubmodule σ R e).add_mem (ihp a) (ihq a)
    | smul b p hp ih =>
        intro a
        change homogeneousComponent (d + e) (a * (b * p)) ∈
          W * homogeneousSubmodule σ R e
        rw [← mul_assoc]
        exact ih (a * b)
  simpa using hall 1

/-- Membership of a homogeneous polynomial in an ideal generated in one degree reduces
to membership in the product with homogeneous polynomials of the complementary degree. -/
theorem mem_ideal_span_iff_mem_mul_homogeneousSubmodule (e : ℕ)
    (W : Submodule R (MvPolynomial σ R)) (hW : W ≤ homogeneousSubmodule σ R d)
    {p : MvPolynomial σ R} (hp : p.IsHomogeneous (d + e)) :
    p ∈ Ideal.span (W : Set (MvPolynomial σ R)) ↔
      p ∈ W * homogeneousSubmodule σ R e := by
  constructor
  · intro h
    have hm := homogeneousComponent_mem_mul_of_mem_ideal_span e W hW h
    rwa [homogeneousComponent_eq_self hp] at hm
  · intro h
    refine Submodule.mul_induction_on h ?_ ?_
    · intro f hf a ha
      exact Ideal.mul_mem_right _ _ (Ideal.subset_span hf)
    · intro f g hf hg
      exact Ideal.add_mem _ hf hg

/-- Homogeneous components below the degree of a homogeneous factor vanish. -/
theorem homogeneousComponent_mul_eq_zero_of_lt (j : ℕ) (hj : j < d)
    (f p : MvPolynomial σ R) (hf : f.IsHomogeneous d) :
    homogeneousComponent j (f * p) = 0 := by
  induction p using MvPolynomial.induction_on' with
  | monomial a c =>
      have ha : (monomial a c : MvPolynomial σ R).IsHomogeneous a.degree :=
        isHomogeneous_monomial c rfl
      rw [homogeneousComponent_of_mem (hf.mul ha)]
      simp [show j ≠ d + a.degree by omega]
  | add p q hp hq => simp only [mul_add, map_add, hp, hq, add_zero]

/-- An ideal generated in degree `d` has no homogeneous components below degree `d`. -/
theorem homogeneousComponent_eq_zero_of_mem_ideal_span_of_lt (j : ℕ) (hj : j < d)
    (W : Submodule R (MvPolynomial σ R)) (hW : W ≤ homogeneousSubmodule σ R d)
    {p : MvPolynomial σ R} (hp : p ∈ Ideal.span (W : Set (MvPolynomial σ R))) :
    homogeneousComponent j p = 0 := by
  have hall : ∀ a : MvPolynomial σ R, homogeneousComponent j (a * p) = 0 := by
    induction hp using Submodule.span_induction with
    | mem f hf =>
        intro a
        rw [mul_comm]
        exact homogeneousComponent_mul_eq_zero_of_lt j hj f a (hW hf)
    | zero => intro a; simp
    | add p q hp hq ihp ihq => intro a; simp [mul_add, ihp, ihq]
    | smul b p hp ih =>
        intro a
        change homogeneousComponent j (a * (b * p)) = 0
        simpa only [← mul_assoc] using ih (a * b)
  simpa using hall 1

end MvPolynomial
